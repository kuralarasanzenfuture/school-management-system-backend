{
  "info": {
    "_postman_id": "subgrp-001-postman-collection",
    "name": "Subject Groups Module - School Management System",
    "description": "Complete Postman collection for testing Subject Groups: create subject group, get all groups, school-filtered list via token, check group existence, get details by ID, update group, and delete group.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "SUBJECT_GROUP_ID", "value": "1", "type": "string" },
    { "key": "SCHOOL_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Subject Group",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"name\": \"SCIENCE\",\n  \"description\": \"Physics, Chemistry, Biology stream\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups"]
        }
      }
    },
    {
      "name": "2. Get All Subject Groups",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups"]
        }
      }
    },
    {
      "name": "3. Get Subject Groups By Token (School Scoped)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups/token",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups", "token"]
        }
      }
    },
    {
      "name": "4. Check Subject Group Existence",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups/check-subject-group?school_id={{SCHOOL_ID}}&name=SCIENCE",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups", "check-subject-group"],
          "query": [
            { "key": "school_id", "value": "{{SCHOOL_ID}}" },
            { "key": "name", "value": "SCIENCE" }
          ]
        }
      }
    },
    {
      "name": "5. Get Subject Group By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups/{{SUBJECT_GROUP_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups", "{{SUBJECT_GROUP_ID}}"]
        }
      }
    },
    {
      "name": "6. Update Subject Group",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"ADVANCED SCIENCE\",\n  \"description\": \"Updated stream description\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups/{{SUBJECT_GROUP_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups", "{{SUBJECT_GROUP_ID}}"]
        }
      }
    },
    {
      "name": "7. Delete Subject Group",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/subject-groups/{{SUBJECT_GROUP_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "subject-groups", "{{SUBJECT_GROUP_ID}}"]
        }
      }
    }
  ]
}
