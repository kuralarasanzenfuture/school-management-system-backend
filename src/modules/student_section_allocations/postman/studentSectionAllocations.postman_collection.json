{
  "info": {
    "_postman_id": "ssa-002-postman-collection",
    "name": "Student Section Allocations Module - School Management System",
    "description": "Comprehensive Postman collection for Student Section Allocations: single allocation, section transfers with auto-effective_to closing, bulk allocations, class students discovery, student history, check existing allocation, query by token, update, and delete with audit trail.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "ALLOCATION_ID", "value": "1", "type": "string" },
    { "key": "ADMISSION_ID", "value": "1", "type": "string" },
    { "key": "STUDENT_ID", "value": "1", "type": "string" },
    { "key": "CLASS_SECTION_ID", "value": "1", "type": "string" },
    { "key": "NEW_CLASS_SECTION_ID", "value": "2", "type": "string" },
    { "key": "CLASS_ID", "value": "1", "type": "string" },
    { "key": "ACADEMIC_YEAR_ID", "value": "1", "type": "string" },
    { "key": "SCHOOL_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Initial Section Allocation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Allocation created successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "    if (jsonData.data && jsonData.data.id) {",
              "        pm.collectionVariables.set(\"ALLOCATION_ID\", jsonData.data.id.toString());",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"admission_id\": {{ADMISSION_ID}},\n  \"class_section_id\": {{CLASS_SECTION_ID}},\n  \"roll_no\": \"101\",\n  \"allocation_date\": \"2026-06-01\",\n  \"remarks\": \"Initial section allocation\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"]
        }
      }
    },
    {
      "name": "2. Transfer Section (Auto-Closes Previous Allocation)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Previous allocation was closed\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.closed_previous_allocations).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"admission_id\": {{ADMISSION_ID}},\n  \"class_section_id\": {{NEW_CLASS_SECTION_ID}},\n  \"roll_no\": \"205\",\n  \"allocation_date\": \"2026-10-22\",\n  \"remarks\": \"Transferred to Section B\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"]
        }
      }
    },
    {
      "name": "3. Create Section Allocation By Student ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": {{STUDENT_ID}},\n  \"class_section_id\": {{CLASS_SECTION_ID}},\n  \"roll_no\": \"105\",\n  \"allocation_date\": \"2026-10-22\",\n  \"remarks\": \"Allocated using student_id resolution\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"]
        }
      }
    },
    {
      "name": "4. Bulk Create / Transfer Section Allocations",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Bulk counts returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.total).to.be.above(0);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"class_id\": {{CLASS_ID}},\n  \"academic_year_id\": {{ACADEMIC_YEAR_ID}},\n  \"school_id\": {{SCHOOL_ID}},\n  \"default_class_section_id\": {{CLASS_SECTION_ID}},\n  \"allocation_date\": \"2026-06-01\",\n  \"status\": \"active\",\n  \"remarks\": \"Bulk allocation for class\",\n  \"allocations\": [\n    {\n      \"admission_id\": {{ADMISSION_ID}},\n      \"student_id\": {{STUDENT_ID}},\n      \"class_section_id\": {{CLASS_SECTION_ID}},\n      \"roll_no\": \"101\",\n      \"allocation_date\": \"2026-06-01\",\n      \"remarks\": \"Assigned via bulk\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/bulk",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "bulk"]
        }
      }
    },
    {
      "name": "5. Get All Allocations (Filtered: Active Only)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations?active_only=true",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"],
          "query": [
            { "key": "active_only", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "6. Get All Allocations (Multi-Filter & Search)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations?class_section_id={{CLASS_SECTION_ID}}&admission_id={{ADMISSION_ID}}&status=active&search=",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"],
          "query": [
            { "key": "class_section_id", "value": "{{CLASS_SECTION_ID}}" },
            { "key": "admission_id", "value": "{{ADMISSION_ID}}" },
            { "key": "status", "value": "active" },
            { "key": "search", "value": "" }
          ]
        }
      }
    },
    {
      "name": "7. Get All Allocations By Token (Role & School Scoped)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/token?active_only=true",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "token"],
          "query": [
            { "key": "active_only", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "8. Get Class Students For Allocation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array of admitted students\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/class-students?class_id={{CLASS_ID}}&academic_year_id={{ACADEMIC_YEAR_ID}}&status=unallocated",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "class-students"],
          "query": [
            { "key": "class_id", "value": "{{CLASS_ID}}" },
            { "key": "academic_year_id", "value": "{{ACADEMIC_YEAR_ID}}" },
            { "key": "status", "value": "unallocated", "description": "unallocated | allocated | all" },
            { "key": "search", "value": "", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "9. Get Section Allocation History (Query Param)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"History array returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/history?admission_id={{ADMISSION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "history"],
          "query": [
            { "key": "admission_id", "value": "{{ADMISSION_ID}}" },
            { "key": "student_id", "value": "{{STUDENT_ID}}", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "10. Get Section Allocation History By Admission ID Param",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"History array returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/history/{{ADMISSION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "history", "{{ADMISSION_ID}}"]
        }
      }
    },
    {
      "name": "11. Check Existing Allocation (Non-Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Check result contains exists flag\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('exists');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/check-allocation?admission_id={{ADMISSION_ID}}&active_only=true",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "check-allocation"],
          "query": [
            { "key": "admission_id", "value": "{{ADMISSION_ID}}" },
            { "key": "active_only", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "12. Check Existing Allocation By Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Check result contains exists flag\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('exists');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/check-allocation/token?admission_id={{ADMISSION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "check-allocation", "token"],
          "query": [
            { "key": "admission_id", "value": "{{ADMISSION_ID}}" },
            { "key": "student_id", "value": "{{STUDENT_ID}}", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "13. Get Section Allocation By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Allocation record returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(parseInt(pm.collectionVariables.get(\"ALLOCATION_ID\")));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/{{ALLOCATION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "{{ALLOCATION_ID}}"]
        }
      }
    },
    {
      "name": "14. Update Section Allocation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Update message returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include(\"successfully\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roll_no\": \"110\",\n  \"remarks\": \"Updated roll number and remarks\",\n  \"effective_to\": \"2026-12-31\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/{{ALLOCATION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "{{ALLOCATION_ID}}"]
        }
      }
    },
    {
      "name": "15. Delete Section Allocation",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Delete message returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include(\"deleted\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/{{ALLOCATION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "{{ALLOCATION_ID}}"]
        }
      }
    }
  ]
}
