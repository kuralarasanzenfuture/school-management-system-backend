{
  "info": {
    "_postman_id": "ssa-001-postman-collection",
    "name": "Student Section Allocations Module - School Management System",
    "description": "Collection for testing Student Section Allocations: initial allocation, section transfers with automated effective_to closeout, queries, updates, and delete with audit logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "ALLOCATION_ID", "value": "1", "type": "string" },
    { "key": "ADMISSION_ID", "value": "1", "type": "string" },
    { "key": "STUDENT_ID", "value": "1", "type": "string" },
    { "key": "CLASS_SECTION_ID", "value": "1", "type": "string" },
    { "key": "NEW_CLASS_SECTION_ID", "value": "2", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Initial Section Allocation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"admission_id\": {{ADMISSION_ID}},\n  \"class_section_id\": {{CLASS_SECTION_ID}},\n  \"roll_no\": \"101\",\n  \"allocation_date\": \"2026-06-01\",\n  \"remarks\": \"Initial section allocation\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"]
        }
      }
    },
    {
      "name": "2. Transfer Section (Auto-Handles effective_to)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"admission_id\": {{ADMISSION_ID}},\n  \"class_section_id\": {{NEW_CLASS_SECTION_ID}},\n  \"roll_no\": \"205\",\n  \"allocation_date\": \"2026-10-22\",\n  \"remarks\": \"Transferred to Section B\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"]
        }
      }
    },
    {
      "name": "3. Create Section Allocation Using student_id",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"student_id\": {{STUDENT_ID}},\n  \"class_section_id\": {{CLASS_SECTION_ID}},\n  \"roll_no\": \"105\",\n  \"allocation_date\": \"2026-10-22\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"]
        }
      }
    },
    {
      "name": "4. Get All Allocations (Active Only)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations?active_only=true",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"],
          "query": [
            { "key": "active_only", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "5. Get All Allocations (Filtered by Section and Student)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations?class_section_id={{CLASS_SECTION_ID}}&admission_id={{ADMISSION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations"],
          "query": [
            { "key": "class_section_id", "value": "{{CLASS_SECTION_ID}}" },
            { "key": "admission_id", "value": "{{ADMISSION_ID}}" }
          ]
        }
      }
    },
    {
      "name": "6. Get All Allocations By Token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/token?active_only=true",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "token"],
          "query": [
            { "key": "active_only", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "7. Check Existing Active Allocation By Token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/check-allocation/token?admission_id={{ADMISSION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "check-allocation", "token"],
          "query": [
            { "key": "admission_id", "value": "{{ADMISSION_ID}}" }
          ]
        }
      }
    },
    {
      "name": "8. Get Section Allocation By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/{{ALLOCATION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "{{ALLOCATION_ID}}"]
        }
      }
    },
    {
      "name": "9. Update Section Allocation",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"roll_no\": \"110\",\n  \"remarks\": \"Updated roll number\",\n  \"effective_to\": \"2026-12-31\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/{{ALLOCATION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "{{ALLOCATION_ID}}"]
        }
      }
    },
    {
      "name": "10. Delete Section Allocation",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/student-section-allocations/{{ALLOCATION_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "student-section-allocations", "{{ALLOCATION_ID}}"]
        }
      }
    }
  ]
}
