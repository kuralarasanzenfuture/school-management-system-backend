{
  "info": {
    "_postman_id": "cls-sub-001-postman-collection",
    "name": "Class Subjects Module - School Management System",
    "description": "Complete Postman collection for testing Class Subjects: assign subjects to class sections, bulk subject assignment, detailed school-scoped views, existence checks, updates, and deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "CLASS_SUBJECT_ID", "value": "1", "type": "string" },
    { "key": "CLASS_SECTION_ID", "value": "1", "type": "string" },
    { "key": "SUBJECT_ID", "value": "1", "type": "string" },
    { "key": "SUBJECT_GROUP_ID", "value": "1", "type": "string" },
    { "key": "EMPLOYEE_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Class Subject",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"class_section_id\": {{CLASS_SECTION_ID}},\n  \"subject_id\": {{SUBJECT_ID}},\n  \"subject_group_id\": {{SUBJECT_GROUP_ID}},\n  \"employee_id\": {{EMPLOYEE_ID}},\n  \"is_optional\": false,\n  \"weekly_periods\": 5\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects"]
        }
      }
    },
    {
      "name": "2. Bulk Assign Subjects",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"class_section_id\": {{CLASS_SECTION_ID}},\n  \"subjects\": [\n    {\n      \"subject_id\": {{SUBJECT_ID}},\n      \"subject_group_id\": {{SUBJECT_GROUP_ID}},\n      \"employee_id\": {{EMPLOYEE_ID}},\n      \"is_optional\": false,\n      \"weekly_periods\": 5\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/bulk-assign-subjects",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "bulk-assign-subjects"]
        }
      }
    },
    {
      "name": "3. Get All Class Subjects",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects"]
        }
      }
    },
    {
      "name": "4. Get Class Subjects By Token (School Scoped)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/token",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "token"]
        }
      }
    },
    {
      "name": "5. Get Detailed Class Subjects (With Teacher & Group)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/detailed",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "detailed"]
        }
      }
    },
    {
      "name": "6. Check Class Subject Existence",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/check-class-subject?class_section_id={{CLASS_SECTION_ID}}&subject_id={{SUBJECT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "check-class-subject"],
          "query": [
            { "key": "class_section_id", "value": "{{CLASS_SECTION_ID}}" },
            { "key": "subject_id", "value": "{{SUBJECT_ID}}" }
          ]
        }
      }
    },
    {
      "name": "7. Get Class Subject By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/{{CLASS_SUBJECT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "{{CLASS_SUBJECT_ID}}"]
        }
      }
    },
    {
      "name": "8. Update Class Subject",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject_group_id\": {{SUBJECT_GROUP_ID}},\n  \"employee_id\": {{EMPLOYEE_ID}},\n  \"is_optional\": false,\n  \"weekly_periods\": 6\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/{{CLASS_SUBJECT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "{{CLASS_SUBJECT_ID}}"]
        }
      }
    },
    {
      "name": "9. Delete Class Subject",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/class-subjects/{{CLASS_SUBJECT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "class-subjects", "{{CLASS_SUBJECT_ID}}"]
        }
      }
    }
  ]
}
