            },
            "description": "Filters overnight / night shifts."
          },
          "response": []
        },
        {
          "name": "10. Filter by Default Shift (?is_default=true)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?is_default=true",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "is_default", "value": "true", "description": "Filter institution default shifts" }
              ]
            },
            "description": "Fetches only default assigned shifts."
          },
          "response": []
        },
        {
          "name": "11. Filter by Name (?name=MORNING)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?name=MORNING",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "name", "value": "MORNING", "description": "Filter by shift name" }
              ]
            },
            "description": "Filters shifts matching name substring."
          },
          "response": []
        },
        {
          "name": "12. Sort by Name Ascending (?sort_by=name&sort_order=ASC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?sort_by=name&sort_order=ASC",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "sort_by", "value": "name" },
                { "key": "sort_order", "value": "ASC" }
              ]
            },
            "description": "Alphabetical sorting by shift name."
          },
          "response": []
        },
        {
          "name": "13. Sort by Working Hours Descending (?sort_by=working_hours&sort_order=DESC)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?sort_by=working_hours&sort_order=DESC",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "sort_by", "value": "working_hours" },
                { "key": "sort_order", "value": "DESC" }
              ]
            },
            "description": "Sorts shifts by longest working hours first."
          },
          "response": []
        },
        {
          "name": "14. Pagination Page 1 Limit 10 (?page=1&limit=10)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?page=1&limit=10",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Fetches page 1 with 10 records. Pagination headers attached."
          },
          "response": []
        },
        {
          "name": "15. Paginated Response with Metadata Envelope (?paginate=true)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?page=1&limit=10&paginate=true",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "paginate", "value": "true", "description": "Returns full pagination, filter_display, and total count metadata" }
              ]
            },
            "description": "Returns structured JSON response with pagination object and active filter display."
          },
          "response": []
        },
        {
          "name": "16. Combined Multi-Filter Test",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?search=Shift&status=active&shift_type=day&school_id={{SCHOOL_ID}}&sort_by=name&sort_order=ASC&page=1&limit=10&paginate=true",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "search", "value": "Shift" },
                { "key": "status", "value": "active" },
                { "key": "shift_type", "value": "day" },
                { "key": "school_id", "value": "{{SCHOOL_ID}}" },
                { "key": "sort_by", "value": "name" },
                { "key": "sort_order", "value": "ASC" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "paginate", "value": "true" }
              ]
            },
            "description": "Comprehensive combined query testing multi-dimensional filtering."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Token-Scoped GET APIs (School Bound)",
