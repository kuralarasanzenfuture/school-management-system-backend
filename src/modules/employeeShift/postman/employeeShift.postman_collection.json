                { "key": "q", "value": "Night", "description": "Shorthand search parameter" }
              ]
            },
            "description": "Shorthand query search across shifts."
          },
          "response": []
        },
        {
          "name": "4. Filter by Single School ID (?school_id=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?school_id={{SCHOOL_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "school_id", "value": "{{SCHOOL_ID}}", "description": "Filter by target school ID" }
              ]
            },
            "description": "Filters shifts belonging to a specific school."
          },
          "response": []
