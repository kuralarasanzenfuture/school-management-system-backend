          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts/token",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts", "token"]
            },
            "description": "Fetches shifts strictly bound to the authenticated user's school."
          },
