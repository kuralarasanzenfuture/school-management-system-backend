              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "school_id", "value": "1,2", "description": "Comma-separated school IDs" }
              ]
            },
            "description": "Filters shifts spanning multiple institutions."
          },
          "response": []
        },
        {
          "name": "6. Filter by Status Active (?status=active)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?status=active",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "status", "value": "active", "description": "Filter active shifts" }
              ]
            },
            "description": "Filters shifts with active status."
          },
          "response": []
        },
        {
          "name": "7. Filter by Status Inactive (?status=inactive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?status=inactive",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "status", "value": "inactive", "description": "Filter inactive shifts" }
              ]
            },
            "description": "Filters inactive shifts."
          },
          "response": []
        },
        {
          "name": "8. Filter by Shift Type Day (?shift_type=day)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?shift_type=day",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "shift_type", "value": "day", "description": "Shift types: day, evening, night, flexible" }
              ]
            },
            "description": "Filters daytime shifts."
          },
          "response": []
        },
        {
          "name": "9. Filter by Shift Type Night (?shift_type=night)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?shift_type=night",
