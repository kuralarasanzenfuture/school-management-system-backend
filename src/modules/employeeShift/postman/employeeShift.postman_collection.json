{
  "info": {
    "_postman_id": "emp-shift-001-postman-collection",
    "name": "Employee Shift Module - School Management System",
    "description": "Complete Postman collection for testing Employee Shifts: CRUD operations, midnight shifts, advanced filtering, token-scoped lookups, sorting, pagination metadata, status toggling, and audit logging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "SHIFT_ID", "value": "1", "type": "string" },
    { "key": "SCHOOL_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Shift Lifecycle (CRUD & Status)",
      "item": [
        {
          "name": "1. Create Shift (Day / Standard Morning)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"name\": \"MORNING SHIFT\",\n  \"shift_type\": \"day\",\n  \"start_time\": \"08:30:00\",\n  \"end_time\": \"16:30:00\",\n  \"grace_minutes\": 15,\n  \"is_default\": true,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"]
            },
            "description": "Creates a standard day shift. Working hours (8.00) are automatically calculated and logged in audit logs."
          },
          "response": []
        },
        {
          "name": "2. Create Shift (Night Shift / Crosses Midnight)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"name\": \"NIGHT SECURITY SHIFT\",\n  \"shift_type\": \"night\",\n  \"start_time\": \"22:00:00\",\n  \"end_time\": \"06:00:00\",\n  \"crosses_midnight\": true,\n  \"grace_minutes\": 10,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"]
            },
            "description": "Creates a night shift crossing midnight with automated calculation (8.00 hrs)."
          },
          "response": []
        },
        {
          "name": "3. Get Shift by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts/{{SHIFT_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts", "{{SHIFT_ID}}"]
            },
            "description": "Fetches single shift details by primary key ID along with joined school details."
          },
          "response": []
        },
        {
          "name": "4. Update Shift by ID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"REGULAR MORNING SHIFT\",\n  \"start_time\": \"08:00:00\",\n  \"end_time\": \"16:00:00\",\n  \"grace_minutes\": 10,\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts/{{SHIFT_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts", "{{SHIFT_ID}}"]
            },
            "description": "Updates shift attributes with automated diff audit logging."
          },
          "response": []
        },
        {
          "name": "5. Update Shift Status (Toggle Active/Inactive)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts/status/{{SHIFT_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts", "status", "{{SHIFT_ID}}"]
            },
            "description": "Toggles shift active/inactive status and logs ACTIVATE / DEACTIVATE audit action."
          },
          "response": []
        },
        {
          "name": "6. Delete Shift by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts/{{SHIFT_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts", "{{SHIFT_ID}}"]
            },
            "description": "Deletes shift record and records DELETE audit log snapshot."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Advanced Filter & Search APIs",
      "item": [
        {
          "name": "1. Get all shifts (Base list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"]
            },
            "description": "Lists all employee shifts across institutions."
          },
          "response": []
        },
        {
          "name": "2. Filter by Global Search (?search=Morning)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/employee-shifts?search=Morning",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "employee-shifts"],
              "query": [
                { "key": "search", "value": "Morning", "description": "Search across shift name and school name" }
              ]
            },
            "description": "Searches shifts matching 'Morning'."
          },
          "response": []
        },
        {
          "name": "3. Filter by Query Search (?q=Night)",
          "request": {
            "method": "GET",
