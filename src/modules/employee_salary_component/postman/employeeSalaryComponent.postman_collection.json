{
  "info": {
    "_postman_id": "sal-comp-001-postman-collection",
    "name": "Employee Salary Components Module - School Management System",
    "description": "Complete Postman collection for testing Employee Salary Components: create earning/deduction components, get all components, school-filtered list via token, existence checks, get details by ID, update component, and delete component.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "COMPONENT_ID", "value": "1", "type": "string" },
    { "key": "SCHOOL_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Earning Component",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"name\": \"BASIC PAY\",\n  \"code\": \"BASIC_PAY\",\n  \"component_type\": \"earning\",\n  \"calculation_type\": \"fixed\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components"]
        }
      }
    },
    {
      "name": "2. Create Deduction Component",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"name\": \"PROVIDENT FUND\",\n  \"code\": \"PF\",\n  \"component_type\": \"deduction\",\n  \"calculation_type\": \"percentage\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components"]
        }
      }
    },
    {
      "name": "3. Get All Salary Components",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components"]
        }
      }
    },
    {
      "name": "4. Get Salary Components By Token (School Scoped)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components/token",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components", "token"]
        }
      }
    },
    {
      "name": "5. Check Component Existence",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components/check-existing?school_id={{SCHOOL_ID}}&code=BASIC_PAY&name=BASIC PAY",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components", "check-existing"],
          "query": [
            { "key": "school_id", "value": "{{SCHOOL_ID}}" },
            { "key": "code", "value": "BASIC_PAY" },
            { "key": "name", "value": "BASIC PAY" }
          ]
        }
      }
    },
    {
      "name": "6. Get Salary Component By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components/{{COMPONENT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components", "{{COMPONENT_ID}}"]
        }
      }
    },
    {
      "name": "7. Update Salary Component",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"BASIC SALARY\",\n  \"calculation_type\": \"fixed\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components/{{COMPONENT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components", "{{COMPONENT_ID}}"]
        }
      }
    },
    {
      "name": "8. Delete Salary Component",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/employee-salary-components/{{COMPONENT_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "employee-salary-components", "{{COMPONENT_ID}}"]
        }
      }
    }
  ]
}
