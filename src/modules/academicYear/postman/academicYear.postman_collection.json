{
  "info": {
    "_postman_id": "ay-001-postman-collection",
    "name": "Academic Years Module - School Management System",
    "description": "Complete Postman collection for testing Academic Years: create academic year, get all years, school-filtered list via token, get details by ID, update academic year, and delete academic year.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "ACADEMIC_YEAR_ID", "value": "1", "type": "string" },
    { "key": "SCHOOL_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Academic Year",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2027-05-31\",\n  \"is_current\": true,\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/academic-years",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "academic-years"]
        }
      }
    },
    {
      "name": "2. Get All Academic Years",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/academic-years?school_id={{SCHOOL_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "academic-years"],
          "query": [
            { "key": "school_id", "value": "{{SCHOOL_ID}}" }
          ]
        }
      }
    },
    {
      "name": "3. Get Academic Years By Token (School Scoped)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/academic-years/token",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "academic-years", "token"]
        }
      }
    },
    {
      "name": "4. Get Academic Year By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/academic-years/{{ACADEMIC_YEAR_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "academic-years", "{{ACADEMIC_YEAR_ID}}"]
        }
      }
    },
    {
      "name": "5. Update Academic Year",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start_date\": \"2026-06-01\",\n  \"end_date\": \"2027-05-31\",\n  \"is_current\": true,\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/academic-years/{{ACADEMIC_YEAR_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "academic-years", "{{ACADEMIC_YEAR_ID}}"]
        }
      }
    },
    {
      "name": "6. Delete Academic Year",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/academic-years/{{ACADEMIC_YEAR_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "academic-years", "{{ACADEMIC_YEAR_ID}}"]
        }
      }
    }
  ]
}
