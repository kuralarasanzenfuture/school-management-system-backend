{
  "info": {
    "_postman_id": "cls-001-postman-collection",
    "name": "Classes Module - School Management System",
    "description": "Complete Postman collection for testing Classes: create class, get all classes, school-filtered list via token, get by school ID, class name existence checks, update class, and delete class.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000", "type": "string" },
    { "key": "TOKEN", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "CLASS_ID", "value": "1", "type": "string" },
    { "key": "SCHOOL_ID", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Create Class",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"school_id\": {{SCHOOL_ID}},\n  \"name\": \"10\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/classes",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes"]
        }
      }
    },
    {
      "name": "2. Get All Classes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/classes",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes"]
        }
      }
    },
    {
      "name": "3. Get Classes By Token (School Scoped)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/classes/token",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "token"]
        }
      }
    },
    {
      "name": "4. Get Classes By School ID (Param)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/classes/school/{{SCHOOL_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "school", "{{SCHOOL_ID}}"]
        }
      }
    },
    {
      "name": "5. Check Class Existence (Query)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/classes/check-class?school_id={{SCHOOL_ID}}&name=10",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "check-class"],
          "query": [
            { "key": "school_id", "value": "{{SCHOOL_ID}}" },
            { "key": "name", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "6. Check Class Existence By Token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/classes/check-class/token?name=10",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "check-class", "token"],
          "query": [
            { "key": "name", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "7. Get Class By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{BASE_URL}}/api/classes/{{CLASS_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "{{CLASS_ID}}"]
        }
      }
    },
    {
      "name": "8. Update Class",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"10A\",\n  \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{BASE_URL}}/api/classes/{{CLASS_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "{{CLASS_ID}}"]
        }
      }
    },
    {
      "name": "9. Delete Class",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{BASE_URL}}/api/classes/{{CLASS_ID}}",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "classes", "{{CLASS_ID}}"]
        }
      }
    }
  ]
}
